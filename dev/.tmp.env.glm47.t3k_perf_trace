# Dev Environment Configuration (GLM-4.7-Flash perf-first on T3K)
#
# Purpose:
# - Maximize decode throughput (target >=20 tok/s).
# - Use TT trace for decode-only, plus on-device sampling to avoid logits readback.
# - Prefer BF16/BF8 math; FP32 parity is explicitly not required.
#
# Usage:
#   cd dev
#   docker compose --env-file .tmp.env.glm47.t3k_perf_trace up -d --force-recreate vllm-tt
#
# Notes:
# - If trace capture fails with "only 0B is allocated for trace region", increase
#   `trace_region_size` per the required size printed in logs.
# - If GLM weight load OOMs, decrease `trace_region_size` first.
#

# Path to your workspace (required)
WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

# Model configuration
HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

# Device configuration
MESH_DEVICE=T3K

# Build configuration
BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

# vLLM configuration
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=7200

# vLLM TT backend overrides (JSON dict passed to --override-tt-config)
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","trace_region_size":40000000,"enable_model_warmup":true,"sample_on_device_mode":"decode_only"}

# Disable GLM thinking by default for user-facing quality/latency.
GLM_DEFAULT_DISABLE_THINKING=1

# ---- GLM bring-up toggles (model-specific) ----
GLM4_MOE_LITE_ENABLE_MOE=1

# Avoid FlashMLA prefill trace capture stalls; use a traced decode-loop prefill.
GLM4_MOE_LITE_PREFILL_IMPL=decode_loop_trace

# KV cache dtype (BF8 currently required on this system for stability)
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

# Perf toggles (keep behind this env so correctness envs stay conservative)
GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=1
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1

# Router + experts implementation
GLM4_MOE_LITE_MOE_ROUTER_IMPL=tt
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse

# MoE sparse math: trade accuracy for speed (BF16/BF8 is acceptable)
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi2
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0

# Dense/router matmuls: no fp32 accumulation in perf mode
GLM4_MOE_LITE_MOE_FP32_ACC=0

# MLA math: trade accuracy for speed
GLM4_MOE_LITE_MLA_FIDELITY=hifi2
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0

# Data types
GLM4_MOE_LITE_DENSE_TT_DTYPE=bf16
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8

# Optional: stage profiling (off by default for perf)
GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32
