# Dev Environment Configuration (GLM-4.7-Flash perf profiling on T3K)
#
# Purpose:
# - Collect stage-level timing without TT trace (GLM4_MOE_LITE_PROFILE=1).
# - Keep the same perf math/dtypes as the trace perf env so numbers are comparable.
#
# Usage:
#   cd dev
#   docker compose --env-file .tmp.env.glm47.t3k_perf_profile up -d --force-recreate vllm-tt
#

WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

MESH_DEVICE=T3K

BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=7200

# No trace here; we want per-stage python timings.
OVERRIDE_TT_CONFIG={"trace_mode":"none","enable_model_warmup":false,"sample_on_device_mode":"decode_only"}

GLM_DEFAULT_DISABLE_THINKING=1

GLM4_MOE_LITE_ENABLE_MOE=1
GLM4_MOE_LITE_PREFILL_IMPL=decode_loop

GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=1
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1

GLM4_MOE_LITE_MOE_ROUTER_IMPL=tt
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse

GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi2
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0

GLM4_MOE_LITE_MOE_FP32_ACC=0

GLM4_MOE_LITE_MLA_FIDELITY=hifi2
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0

GLM4_MOE_LITE_DENSE_TT_DTYPE=bf16
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8

GLM4_MOE_LITE_PROFILE=1
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=1
