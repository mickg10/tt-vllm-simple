# Dev Environment Configuration
# Copy to .env and customize

# Path to your workspace (required)
# This should point to a workspace created with 'make workspace-create'
WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

# Model configuration
HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

# Device configuration
MESH_DEVICE=N150

# Build configuration
BUILD_JOBS=16

# Skip tt-metal rebuild (set to 1 after first successful build)
# Useful for faster restarts when only changing Python code
SKIP_TT_METAL_BUILD=1

# vLLM configuration
# Default: keep this high enough for agentic UIs (opencode/Open WebUI tools),
# which can inject large system prompts (tools + instructions).
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=600
# vLLM TT backend overrides (JSON dict passed to --override-tt-config)
OVERRIDE_TT_CONFIG={"trace_mode":"none","enable_model_warmup":false}
# Disable GLM thinking by default for user-facing quality/latency.
GLM_DEFAULT_DISABLE_THINKING=1

# GLM bring-up toggles (model-specific)
# `GLM4_MOE_LITE_PREFILL_IMPL=flash_mla_prefill` is the intended path (MoE supported).
GLM4_MOE_LITE_ENABLE_MOE=0
# Correctness-first: keep KV cache in BF16 until BF8 KV path is validated end-to-end.
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf16
GLM4_MOE_LITE_PREFILL_IMPL=decode_loop
# Correctness-first knobs (disable perf shortcuts until outputs are sane)
# - TP sharding and fused QKV_A have previously produced garbled output in this workspace.
# - Start from a known-simple path, then re-enable perf flags one-by-one with gates.
GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=0
# Use the legacy v-cache slicing path while debugging correctness (slower, simpler).
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1
# Dense/non-router projection weight dtype (default bf16). Optional perf experiment:
# GLM4_MOE_LITE_DENSE_TT_DTYPE=bf8
# MoE sparse expert chunking: reduce global prefill token chunks to avoid DRAM OOM on long prompts.
# This is a bring-up safety knob; tune upward for throughput once stable.
GLM4_MOE_LITE_MOE_SPARSE_CHUNK_TOKENS=2048
# Sparse MoE compute defaults tuned for BF16-speed decode. Increase fidelity
# for debugging if quality regressions are observed.
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi4
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=1
GLM4_MOE_LITE_MOE_SPARSE_APPROX=0
# Debug logging for chunking decisions/shapes (0/1).
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=1
# MoE sparse dispatch strategy:
# - `reduce`: replicated tokens + local-expert compute + all-reduce across mesh.
#   This is the intended default for vLLM bring-up where activations are replicated
#   across the mesh (avoids token-count inflation from all_to_all dispatch).
# - `a2a`: all_to_all_dispatch/all_to_all_combine (preferred once inputs are truly DP-sharded).
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
# Debug knob: force dense (all-ones) sparsity mask for sparse_matmul.
# Use to validate correctness if sparse skip is suspected to leave garbage outputs.
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
# MLA decode/prefill kernel math mode. Keep HiFi4 by default; tune lower only
# in controlled perf experiments.
GLM4_MOE_LITE_MLA_FIDELITY=hifi4
GLM4_MOE_LITE_MLA_APPROX=0
# Decode/prefill stage profiling (keep disabled by default).
GLM4_MOE_LITE_PROFILE=0
# Optional layer filter for profiling; empty means all layers.
GLM4_MOE_LITE_PROFILE_LAYER=
# Print aggregate profile line every N decode/prefill calls.
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32
# Optional: speed up bring-up by running a partial model (layer0 dense + first MoE layer).
# GLM4_MOE_LITE_NUM_LAYERS=2
# GLM4_MOE_LITE_DEBUG_ALLOW_PARTIAL_LAYERS=1

GLM4_MOE_LITE_NUM_LAYERS=1
GLM4_MOE_LITE_DEBUG_ALLOW_PARTIAL_LAYERS=1
