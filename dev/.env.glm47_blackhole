# Dev Environment Configuration (GLM-4.7-Flash on Blackhole Galaxy)
#
# Blackhole Galaxy: 32 devices (4×8 physical mesh)
# Logical mesh (8,4): TP=4 (columns), DP=8 (rows) — FASTER than (4,8)/TP=8
# 130 compute cores per device (13×10), 8 GDDR7 channels @ 14 Gbps
# Devices are 666 (world read/write) — docker optional for device access
#
# Usage (ALL THREE compose files required):
#   cd /home/ttuser/src_docker/ws/glm47_flash_blackhole_galaxy/docker_tt
#   docker compose --env-file dev/.env.glm47_blackhole \
#     -f dev/docker-compose.yml -f dev/docker-compose.galaxy.yml \
#     -f dev/docker-compose.blackhole.yml \
#     up -d vllm-tt
#
# Native (no docker):
#   ARCH_NAME=blackhole TT_METAL_HOME=/home/mick/ws/glm47_flash_blackhole_galaxy/tt-metal \
#   PYTHONPATH=...tt-metal:...vllm \
#   .../tt-metal/python_env/bin/python ...

MODEL_ENV_FILE=dev/.env.glm47_blackhole

WORKSPACE_PATH=/home/mick/ws/glm47_flash_blackhole_galaxy

HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=
# No internet access in container — use local cache only
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Pre-downloaded weights on BH machine
MODEL_WEIGHTS_PATH=/home/mick/models/GLM-4.7-Flash

# Blackhole Galaxy mesh: 32 devices
# (8,4) = TP=4, DP=8 — 8.6 tok/s bs=1, 280.6 tok/s bs=32 (2026-03-08)
# (4,8) = TP=8, DP=4 — 5.38 tok/s bs=1 (SLOWER, do NOT use)
MESH_DEVICE=(8,4)

# Architecture override for Blackhole
ARCH_NAME=blackhole

BUILD_JOBS=32
SKIP_TT_METAL_BUILD=0

MAX_MODEL_LEN=32768
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=7200

OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","trace_region_size":250000000,"enable_model_warmup":true,"sample_on_device_mode":"decode_only","decode_trace_batch_buckets":[1,2,4,8,16,32]}

GLM_DEFAULT_DISABLE_THINKING=1

GLM4_MOE_LITE_ENABLE_MOE=1
GLM4_MOE_LITE_PREFILL_IMPL=flash_mla_prefill
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

# Perf toggles — start with safe defaults for Blackhole bring-up
GLM4_MOE_LITE_TP=1
GLM4_MOE_LITE_TP_PREFILL=1
GLM4_MOE_LITE_DECODE_L1_ACT=1
GLM4_MOE_LITE_DRAM_SHARDED_WEIGHTS=0
GLM4_MOE_LITE_DRAM_SHARDED_ATTN=0
GLM4_MOE_LITE_SHARDED_MLP=0
GLM4_MOE_LITE_EXPLICIT_PROG_CFG=1
GLM4_MOE_LITE_FUSE_QKV_A=1
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1
GLM4_MOE_LITE_CONCAT_HEADS=1

GLM4_MOE_LITE_MOE_ROUTER_IMPL=tt
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_LITE_MOE_DENSE_PREFILL=1
GLM4_MOE_LITE_MOE_PACKED_PREFILL=0

GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=lofi
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
GLM4_MOE_LITE_MOE_SPARSE_PREFILL_PCM=32

GLM4_MOE_LITE_EP_L1=1
GLM4_MOE_LITE_FUSE_EXPERTS_GATE_UP=0
GLM4_MOE_LITE_FUSED_MOE=0

GLM4_MOE_LITE_ATTN_DP=0
GLM4_MOE_LITE_HEAD_PARALLEL_KVB2=1
GLM4_MOE_LITE_FUSE_MLP_MOE_REDUCE=1
GLM4_MOE_LITE_FUSE_SHARED_GATE_UP=0
GLM4_MOE_LITE_FUSED_SHARED_EXPERT=0
GLM4_MOE_LITE_FUSED_KV_BRANCH=0
GLM4_MOE_LITE_FUSED_PRE_SDPA=0

GLM4_MOE_LITE_MOE_FP32_ACC=0

GLM4_MOE_LITE_MLA_FIDELITY=lofi
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0
GLM4_MOE_LITE_MLA_SHARD_Q=0

GLM4_MOE_LITE_DENSE_TT_DTYPE=bf8
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8

GLM4_MOE_LITE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_LITE_SKIP_TYPECAST=1
GLM4_MOE_LITE_PRESERVE_TRACE=0

GLM4_MOE_LITE_BATCHED_PREFILL=0

GLM4_MOE_LITE_MTP=0
GLM4_MOE_LITE_MTP_TRACED=0
GLM4_MOE_LITE_BATCH_EXPAND=0

# Use V1 engine
VLLM_USE_V1=1

GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=0
