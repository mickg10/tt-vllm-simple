# Dev Environment Configuration
# Copy to .env and customize

# Path to your workspace (required)
# This should point to a workspace created with 'make workspace-create'
WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

# Model configuration
HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

# Device configuration
MESH_DEVICE=T3K

# Build configuration
BUILD_JOBS=16

# Skip tt-metal rebuild (set to 1 after first successful build)
# Useful for faster restarts when only changing Python code
SKIP_TT_METAL_BUILD=1

# vLLM configuration
# Default: keep this high enough for agentic UIs (opencode/Open WebUI tools),
# which can inject large system prompts (tools + instructions).
MAX_MODEL_LEN=32768
# Keep single-stream decode stable while we bring up tracing + prefill.
# vLLM pads decode batches to max_num_seqs; for GLM trace paths, mismatched
# padded batch sizes between prefill and decode can force costly re-captures.
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
# Some TT prefill shapes can take a long time to compile on first run; keep
# engine iteration timeout high to avoid the engine killing itself mid-request.
VLLM_ENGINE_ITERATION_TIMEOUT_S=7200
# vLLM TT backend overrides (JSON dict passed to --override-tt-config)
# Enable decode tracing + warmup for perf work.
# NOTE: trace buffer errors during capture require increasing trace_region_size.
# The error message prints the required trace buffer size; keep headroom.
# NOTE: GLM trace capture currently needs ~122MB on T3K; keep headroom to avoid
# fatal restarts during the first traced decode.
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","trace_region_size":256000000,"enable_model_warmup":true,"sample_on_device_mode":"decode_only"}
# Disable GLM thinking by default for user-facing quality/latency.
GLM_DEFAULT_DISABLE_THINKING=1

# GLM bring-up toggles (model-specific)
# Prefill implementation:
# - `flash_mla_prefill` is the intended path, but currently compiles too slowly
#   for many prompt lengths in this workspace (can trigger vLLM engine timeouts).
# - `decode_loop_trace` is a pragmatic workaround that replays the decode trace
#   across prompt tokens and avoids reading logits for intermediate tokens.
GLM4_MOE_LITE_ENABLE_MOE=0
# Correctness-first: keep KV cache in BF8 (production-intended). BF16 KV currently
# triggers L1 CB overflow in decode warmup on this system.
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8
# Correctness + manual bring-up default:
# Use iterative decode-per-token prefill to avoid long compilation times for
# FlashMLA prefill graphs (we will switch back once prefill is optimized).
GLM4_MOE_LITE_PREFILL_IMPL=decode_loop_trace
# Correctness-first knobs (disable perf shortcuts until outputs are sane)
# - TP sharding and fused QKV_A have previously produced garbled output in this workspace.
# - Start from a known-simple path, then re-enable perf flags one-by-one with gates.
GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=0
# Avoid per-layer V-cache slicing overhead in decode.
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=0
# Dense/non-router projection weight dtype (default bf16). Perf experiment:
GLM4_MOE_LITE_DENSE_TT_DTYPE=
# Correctness: keep expert weights in BF16 until outputs are sane.
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8
# Correctness: use higher-precision accumulation for dense matmuls (router/MLP/QKV projections).
# This is a temporary bring-up knob; disable once output quality is validated.
GLM4_MOE_LITE_MOE_FP32_ACC=0
# MoE sparse expert chunking: reduce global prefill token chunks to avoid DRAM OOM on long prompts.
# This is a bring-up safety knob; tune upward for throughput once stable.
GLM4_MOE_LITE_MOE_SPARSE_CHUNK_TOKENS=2048
# Sparse MoE compute defaults tuned for BF16-speed decode. Increase fidelity
# for debugging if quality regressions are observed.
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi2
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
# Debug logging for chunking decisions/shapes (0/1).
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
# MoE sparse dispatch strategy:
# - `reduce`: replicated tokens + local-expert compute + all-reduce across mesh.
#   This is the intended default for vLLM bring-up where activations are replicated
#   across the mesh (avoids token-count inflation from all_to_all dispatch).
# - `a2a`: all_to_all_dispatch/all_to_all_combine (preferred once inputs are truly DP-sharded).
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
# Debug knob: force dense (all-ones) sparsity mask for sparse_matmul.
# Use to validate correctness if sparse skip is suspected to leave garbage outputs.
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
# MLA decode/prefill kernel math mode. Keep HiFi4 by default; tune lower only
# in controlled perf experiments.
GLM4_MOE_LITE_MLA_FIDELITY=hifi2
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0
# Decode/prefill stage profiling (keep disabled by default).
GLM4_MOE_LITE_PROFILE=0
# Optional layer filter for profiling; empty means all layers.
GLM4_MOE_LITE_PROFILE_LAYER=
# Print aggregate profile line every N decode/prefill calls.
# Reduce log spam and I/O overhead; set to 1 when actively profiling.
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32
# Optional: speed up bring-up by running a partial model (layer0 dense + first MoE layer).
# NOTE: When doing partial-layer bring-up, GLM quality collapses because MoE starts at layer 1
# (`first_k_dense_replace=1`). Keep full layers for user-facing runs; for low-level kernel debug
# you can temporarily set these, but do not use for perf/quality benchmarking.
# GLM4_MOE_LITE_NUM_LAYERS=2
# GLM4_MOE_LITE_DEBUG_ALLOW_PARTIAL_LAYERS=1
