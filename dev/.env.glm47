# Dev Environment Configuration (GLM-4.7-Flash on T3K — perf-trace + TP)
#
# Native flash_mla_prefill + traced decode. TTFB ~2.4s (short) / ~5.4s (68 tok).
# Decode ~5 tok/s single-query. Tracing enabled, TP sharding on, bf8 KV cache.
#
# Usage:
#   cd /home/ttuser/src_docker/ws/glm47_flash/docker_tt
#   docker compose --env-file dev/.env.glm47 -f dev/docker-compose.yml \
#     up -d --force-recreate vllm-tt
#
# For a correctness-first variant (slower, higher fidelity), see .env.glm47.correctness.

MODEL_ENV_FILE=dev/.env.glm47

WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

MESH_DEVICE=T3K

BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=32768
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=7200

OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","trace_region_size":40000000,"enable_model_warmup":true,"sample_on_device_mode":"decode_only"}

GLM_DEFAULT_DISABLE_THINKING=1

GLM4_MOE_LITE_ENABLE_MOE=1
GLM4_MOE_LITE_PREFILL_IMPL=flash_mla_prefill
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

# Perf toggles
GLM4_MOE_LITE_TP=1
GLM4_MOE_LITE_DECODE_L1_ACT=0
GLM4_MOE_LITE_DRAM_SHARDED_WEIGHTS=0
GLM4_MOE_LITE_SHARDED_MLP=0
GLM4_MOE_LITE_EXPLICIT_PROG_CFG=0
GLM4_MOE_LITE_FUSE_QKV_A=1
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1

GLM4_MOE_LITE_MOE_ROUTER_IMPL=tt
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse
# Dense batched matmul for MoE experts during prefill (0=sparse_matmul, 1=dense ttnn.linear)
GLM4_MOE_LITE_MOE_DENSE_PREFILL=1
# Token-packing prefill: gather only routed tokens per expert (overrides dense prefill)
# Disabled: per-expert loop overhead causes regression vs dense prefill (80 vs 307 tok/s @ 1k ctx)
GLM4_MOE_LITE_MOE_PACKED_PREFILL=0

GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=lofi
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
# Prefill: process up to N sparsity blocks per sparse_matmul call (default 1 = decode-only)
# 32 blocks = 1024 tokens per call → eliminates chunking overhead for 1k prefill
GLM4_MOE_LITE_MOE_SPARSE_PREFILL_PCM=32

# RFC-1 Phase A: L1 memory for MoE decode experts (0=DRAM default, 1=L1)
GLM4_MOE_LITE_EP_L1=1
# RFC-1 Phase B: Fuse w1+w3 gate_up expert projections (0=separate, 1=fused)
GLM4_MOE_LITE_FUSE_EXPERTS_GATE_UP=1

GLM4_MOE_LITE_ATTN_DP=0
GLM4_MOE_LITE_FUSE_MLP_MOE_REDUCE=0

GLM4_MOE_LITE_MOE_FP32_ACC=0

GLM4_MOE_LITE_MLA_FIDELITY=lofi
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0

GLM4_MOE_LITE_DENSE_TT_DTYPE=bf16
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8

GLM4_MOE_LITE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_LITE_PRESERVE_TRACE=0

GLM4_MOE_LITE_BATCHED_PREFILL=0

GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32

