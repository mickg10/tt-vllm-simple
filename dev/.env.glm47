# Dev Environment Configuration (GLM-4.7 358B on Galaxy Wormhole)
# Base GLM-4.7 bringup — using glm4_moe codebase, zero code changes needed for BF16 source model
# GLM-4.7: 92 layers, 160 routed experts (top-8), 1 shared expert, hidden=5120, GQA 96Q/8KV

MODEL_ENV_FILE=dev/.env.glm47
WORKSPACE_PATH=/home/user/src_docker/ws/glm47_reap_268b_galaxy_wormhole
HF_MODEL=zai-org/GLM-4.7
HF_TOKEN=
MESH_DEVICE=TG
BUILD_JOBS=32
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=128
# V1 batch>1 UNBLOCKED via rs_ag workaround for axis-1 EP reduce.
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

# Trace mode WORKING: host-side sampling workaround (on-device sampling garbles inside trace on TG).
# trace_region_size=0 = dynamic allocation (no dedicated region).
# kv_cache_max_tokens reduced from 4096 to 1024 due to DRAM OOM at layer 74 with all-BF4 experts
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","enable_model_warmup":false,"decode_trace_batch_buckets":[1,4,8,16,32],"trace_region_size":0,"kv_cache_max_tokens_all_users":1024}

# Parallelism
GLM4_MOE_TP=8
GLM4_MOE_EP=32

# All-BF4 experts: GLM-4.7 (160 experts × 92 layers) needs all-BF4 to fit 12GB DRAM.
# SEED-3 (w3=BF8) OOMs at layer 89. All-BF4 saves ~1.6GB → fits all 92 layers.
# REAP (96 experts × 5120 intermediate) uses SEED-3; GLM-4.7 (160 × 1536) needs all-BF4.
GLM4_MOE_DENSE_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_W1_DTYPE=bf4
GLM4_MOE_EXPERTS_W2_DTYPE=bf4
GLM4_MOE_EXPERTS_W3_DTYPE=bf4
GLM4_MOE_KV_CACHE_TT_DTYPE=bf16

# MoE configuration
GLM4_MOE_ENABLE_MOE=1
GLM4_MOE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_MOE_ROUTER_IMPL=tt
GLM4_MOE_MOE_DENSE_PREFILL=1
GLM4_MOE_MOE_SPARSE_PREFILL_PCM=32

# Performance flags (conservative)
GLM4_MOE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_EXPLICIT_PROG_CFG=1
GLM4_MOE_DECODE_L1_ACT=0
# EP_L1=1 BROKEN: garbled output on TG mesh. Keep =0.
GLM4_MOE_EP_L1=0
# Fused gate+up: single sparse_matmul for w1+w3. REGRESSION: -14.6% bs=1 due to slice+clone overhead.
GLM4_MOE_FUSE_EXPERTS_GATE_UP=0

# LoFi matmul fidelity for performance (BF8 experts already approximate)
GLM4_MOE_FP32_ACC=0
GLM4_MOE_MOE_SPARSE_FP32_ACC=0

# Use V1 engine
VLLM_USE_V1=1

# Tracy DISABLED
TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0

# Online mode — new model, needs download
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# On-device reduce — rs_ag proven correct (host reduce is BROKEN with DP>1)
GLM4_MOE_REDUCE_IMPL=native
# Axis-1 (DP) reduce uses rs_ag to bypass FABRIC_2D composite crash (batch>1).
# Axis-0 (TP) stays native.
GLM4_MOE_REDUCE_IMPL_AXIS1=rs_ag_async
# FUSE_SHARED_EP_REDUCE=1 BROKEN: causes hang (100+ min, device left in bad state). Keep =0.
GLM4_MOE_FUSE_SHARED_EP_REDUCE=0
GLM4_MOE_EP_REDUCE_DEVICE=1
GLM4_MOE_DRAM_SHARD=0
NUM_GPU_BLOCKS_OVERRIDE=1

# Separate weight cache for GLM-4.7 (160 experts) vs REAP (96 experts)
# Shared cache causes shape mismatch: ep32 key doesn't encode expert count
GLM4_MOE_CACHE_DIR=/root/.cache/ttnn/models/glm4_moe_glm47/vllm

# Lofi fidelity for faster matmuls
# LoFi tested: works (coherent output) but no speedup (-1.5%). DRAM-BW bound, not compute.
# Keeping hifi to avoid kernel cache invalidation on restarts.
GLM4_MOE_ATTN_FIDELITY=hifi
GLM4_MOE_MOE_SPARSE_FIDELITY=hifi

# GLM-4.7: 92 layers, 160 experts. All-BF4 experts + BF4 dense + KV=1024 to fit 12GB DRAM.
# All-BF4 experts alone OOMs at layer 74. Need DENSE_TT_DTYPE=bf4 + reduced KV cache.
# GLM4_MOE_NUM_LAYERS=
# GLM4_MOE_DEBUG_ALLOW_PARTIAL_LAYERS=

# Decode-only mode
VLLM_TT_DECODE_ONLY=1
VLLM_TT_WARMUP_OVERRIDE=true

# Unbuffered Python output for log visibility
PYTHONUNBUFFERED=1

# Debug: synchronize before all_reduce to isolate compute vs CCL hang
GLM4_MOE_DEBUG_SYNC=0
