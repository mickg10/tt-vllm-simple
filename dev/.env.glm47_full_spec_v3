# Dev Environment Configuration (GLM-4.7 Full 358B — SPEC_V2: rs_ag_async + MTP spec decode)
# Based on .env.glm47_full_spec with reduce fix and MTP spec decode enabled

MODEL_ENV_FILE=dev/.env.glm47_full
WORKSPACE_PATH=/home/user/src_docker/ws/glm47_reap_268b_galaxy_wormhole
HF_MODEL=zai-org/GLM-4.7
HF_TOKEN=
MESH_DEVICE=TG
BUILD_JOBS=32
SKIP_TT_METAL_BUILD=1

# Reuse existing BF4 weight cache (fast startup)
GLM4_MOE_CACHE_DIR=/root/.cache/ttnn/models/glm4_moe_glm47_full/vllm

MAX_MODEL_LEN=4096
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

# Trace mode: decode-only
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","enable_model_warmup":false,"decode_trace_batch_buckets":[1,4],"trace_region_size":0,"kv_cache_max_tokens_all_users":4096}

# Parallelism — TP=8, EP=32, DP=4
GLM4_MOE_TP=8
GLM4_MOE_EP=32

# BF4 SEED-3 quantization (same as original)
GLM4_MOE_DENSE_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_W1_DTYPE=bf4
GLM4_MOE_EXPERTS_W2_DTYPE=bf4
GLM4_MOE_EXPERTS_W3_DTYPE=bf8
GLM4_MOE_KV_CACHE_TT_DTYPE=bf16

# MoE configuration
GLM4_MOE_ENABLE_MOE=1
GLM4_MOE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_MOE_ROUTER_IMPL=tt
GLM4_MOE_MOE_DENSE_PREFILL=1
GLM4_MOE_MOE_SPARSE_PREFILL_PCM=32

# MTP ENABLED — K=1 speculative decode
TT_SPEC_DECODE=1
VLLM_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}
GLM4_MOE_MTP=1
GLM4_MOE_MTP_MAX_BATCH=16
GLM4_MOE_MTP_TRACED=1
GLM4_MOE_MTP_DEVICE_EMBED=1

# Performance flags
GLM4_MOE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_EXPLICIT_PROG_CFG=1
GLM4_MOE_DECODE_L1_ACT=0
GLM4_MOE_EP_L1=0
GLM4_MOE_FUSE_EXPERTS_GATE_UP=0
GLM4_MOE_FP32_ACC=0
GLM4_MOE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_QK_L1=1
GLM4_MOE_ROPE_PAD=0

# Use V1 engine
VLLM_USE_V1=1

# Tracy DISABLED
TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0

# Offline mode
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# FIX1: rs_ag_async reduce (was "native" which is BROKEN on TG mesh)
GLM4_MOE_REDUCE_IMPL=native
GLM4_MOE_REDUCE_IMPL_AXIS1=rs_ag_async
GLM4_MOE_FUSE_SHARED_EP_REDUCE=0
GLM4_MOE_EP_REDUCE_DEVICE=1
GLM4_MOE_DRAM_SHARD=0
NUM_GPU_BLOCKS_OVERRIDE=1

# Math fidelity
GLM4_MOE_ATTN_FIDELITY=hifi
GLM4_MOE_MOE_SPARSE_FIDELITY=hifi

# All 92 layers
GLM4_MOE_NUM_LAYERS=92
GLM4_MOE_DEBUG_ALLOW_PARTIAL_LAYERS=1

# Decode-only mode
VLLM_TT_DECODE_ONLY=1
VLLM_TT_WARMUP_OVERRIDE=true

PYTHONUNBUFFERED=1
GLM4_MOE_DEBUG_SYNC=0
