# Dev Environment Configuration (GLM-4.7 / REAP-218B on Blackhole Galaxy)
# FP8 weights, TP=4, EP=32, 32 BH devices
#
# Usage:
#   cd /home/mick/ws/glm47_flash_blackhole_galaxy/docker_tt
#   docker compose -p reap-bh --env-file dev/.env.glm47_reap_blackhole \
#     -f dev/docker-compose.yml -f dev/docker-compose.galaxy.yml \
#     -f dev/docker-compose.blackhole.yml \
#     up -d vllm-tt

MODEL_ENV_FILE=dev/.env.glm47_reap_blackhole

WORKSPACE_PATH=/home/mick/ws/glm47_flash_blackhole_galaxy

# Full GLM-4.7 (355B, 160 experts) — THE ONLY MODEL FOR BH GALAXY
# REAP-218B is BANNED on BH — full model is preferred for quality, both fit in 32GB/device
HF_MODEL=/home/mick/models/GLM-4.7-FP8

HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

MESH_DEVICE=(8,4)
ARCH_NAME=blackhole

BUILD_JOBS=32
SKIP_TT_METAL_BUILD=0

MAX_MODEL_LEN=16384
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

# trace_mode: none=eager (safe), decode_only=trace decode (fast)
# enable_model_warmup: false (skip warmup — trace capture happens on first real request instead)
# trace_region_size: PER DRAM BANK (not total!). BH has 8 banks × 4GB each.
#   0 = dynamic allocation (no fixed reservation, most flexible).
#   400MB/bank = 3.2GB total → OOM at layer 88 (weights don't fit).
#   3GB/bank = 24GB total → starved weight DRAM → trace replay hang.
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","enable_model_warmup":true,"decode_trace_batch_buckets":[1,32],"trace_region_size":250000000,"kv_cache_max_tokens_all_users":4096}

# Parallelism: TP=4 (BH axis=1 columns)
GLM4_MOE_TP=4
GLM4_MOE_EP=32

# Weight dtypes on device
GLM4_MOE_DENSE_TT_DTYPE=bf16
GLM4_MOE_EXPERTS_TT_DTYPE=bf8
GLM4_MOE_KV_CACHE_TT_DTYPE=bf8

# MoE
GLM4_MOE_ENABLE_MOE=1
GLM4_MOE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_MOE_ROUTER_IMPL=tt
GLM4_MOE_MOE_DENSE_PREFILL=1
GLM4_MOE_MOE_SPARSE_PREFILL_PCM=32

# Performance (conservative for bringup)
GLM4_MOE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_EXPLICIT_PROG_CFG=1
GLM4_MOE_DECODE_L1_ACT=0
GLM4_MOE_EP_L1=0

# Matmul fidelity
GLM4_MOE_FP32_ACC=0
GLM4_MOE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_ATTN_FIDELITY=hifi
GLM4_MOE_MOE_SPARSE_FIDELITY=hifi

# Reduce
# rs_ag_async: real all_reduce (correct output, uses ethernet)
# noop: skip CCL (output WRONG, for trace debugging only)
# Device 0 ethernet core (x=27,y=25) intermittently fails on this machine (~50% cold boots).
GLM4_MOE_REDUCE_IMPL=rs_ag_async
GLM4_MOE_REDUCE_IMPL_AXIS1=rs_ag_async
GLM4_MOE_PREFILL_REDUCE_IMPL=rs_ag
GLM4_MOE_FUSE_SHARED_EP_REDUCE=1
GLM4_MOE_EP_REDUCE_DEVICE=1
GLM4_MOE_DRAM_SHARD=0
NUM_GPU_BLOCKS_OVERRIDE=1

# Layers
GLM4_MOE_NUM_LAYERS=92
GLM4_MOE_DEBUG_ALLOW_PARTIAL_LAYERS=1

VLLM_USE_V1=1
VLLM_TT_DECODE_ONLY=1
VLLM_TT_WARMUP_OVERRIDE=true

PYTHONUNBUFFERED=1

TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0

GLM4_MOE_DEBUG_SYNC=0
GLM4_MOE_DEBUG_DECODE=0
# E0(readback), E1(sleep), E3(barrier), E5(capture-vs-replay) — all enabled at >=5
GLM4_MOE_DEBUG_TRACE_VERIFY=0
GLM4_MOE_DEBUG_PT_WIDTH=
GLM4_MOE_USE_FILL_CACHE_DECODE=0
TT_METAL_DPRINT_CORES=0,0
TT_METAL_DPRINT_RISCVS=BR
TT_METAL_DPRINT_CHIPS=0

GLM4_MOE_LITE_PRESERVE_TRACE=0
GLM4_MOE_PREFILL_WARMUP_LENS=128,768,1024

# Phase 2: Suppress dealloc during trace capture retains intermediate addresses.
# PRESERVE_TRACE=1 is now safe — intermediates stay allocated, preventing DRAM reuse.
GLM4_MOE_PRESERVE_TRACE_AFTER_PREFILL=1

# Chunked prefill for long contexts
GLM4_MOE_PREFILL_CHUNK_SIZE=1024
