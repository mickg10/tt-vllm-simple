# Galaxy Llama-3.3-70B-Instruct
#
# Galaxy: 32 Wormhole chips, MESH_DEVICE=TG
# Config values from tt-metal models/demos/llama3_70b_galaxy/PERF.md
#
# Usage:
#   cd docker_tt
#   # Edit this file: set WORKSPACE_PATH and HF_TOKEN
#   docker compose --env-file dev/.env.llama70b.galaxy \
#     -f dev/docker-compose.yml -f dev/docker-compose.galaxy.yml \
#     build vllm-tt
#   docker compose --env-file dev/.env.llama70b.galaxy \
#     -f dev/docker-compose.yml -f dev/docker-compose.galaxy.yml \
#     up -d vllm-tt

WORKSPACE_PATH=/home/user/src_docker
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_TOKEN=
MESH_DEVICE=TG
BUILD_JOBS=32
SKIP_TT_METAL_BUILD=0
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=900000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400
TT_LLAMA_TEXT_VER=llama3_70b_galaxy
OVERRIDE_TT_CONFIG={"dispatch_core_axis":"col","sample_on_device_mode":"all","fabric_config":"FABRIC_1D_RING","worker_l1_size":1344544,"trace_region_size":95693824}
LOGURU_LEVEL=INFO
