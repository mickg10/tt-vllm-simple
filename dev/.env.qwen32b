# Dev Environment Configuration (Qwen32B backtest)
WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

# Model configuration
HF_MODEL=Qwen/Qwen3-32B
HF_TOKEN=

# Device configuration
MESH_DEVICE=T3K

# Build configuration
BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

# vLLM configuration
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=600
OVERRIDE_TT_CONFIG={"sample_on_device_mode":"decode_only","enable_model_warmup":false}
# Work around warmup-time TT_FATAL in tt_penalties slice for Qwen32B by
# skipping TT model warmup. This keeps the Qwen backtest functional while we
# investigate a proper fix upstream/in tt-metal.
# NOTE: first request may be slower without warmup.
# GLM-only knob (ignored for Qwen, set explicitly for clarity)
GLM_DEFAULT_DISABLE_THINKING=0

# GLM bring-up toggles (ignored by non-GLM models)
GLM4_MOE_LITE_ENABLE_MOE=
GLM4_MOE_LITE_PREFILL_IMPL=
GLM4_MOE_LITE_DENSE_TT_DTYPE=
GLM4_MOE_LITE_MOE_SPARSE_CHUNK_TOKENS=
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=
GLM4_MOE_LITE_MOE_SPARSE_APPROX=
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=
GLM4_MOE_LITE_MLA_FIDELITY=
GLM4_MOE_LITE_MLA_APPROX=
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=
GLM4_MOE_LITE_PROFILE=
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=
