# Dev Environment Configuration (GLM-4.7-Flash ultra-correctness on T3K)
#
# Purpose:
# - Maximize numerical stability to debug "gibberish" / drift.
# - Use BF16 KV cache + BF16 expert weights (slow, but should be most stable).
# - Disable tracing and warmup to reduce moving parts.
#
# Usage:
#   cd dev
#   docker compose --env-file .tmp.env.glm47.t3k_ultra_correctness up -d --force-recreate vllm-tt
#

WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

MESH_DEVICE=T3K

BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=600

# No tracing / warmup while debugging correctness.
OVERRIDE_TT_CONFIG={"trace_mode":"none","enable_model_warmup":false,"always_compat_sampling":true}

# Keep default GLM chat template (thinking enabled) while debugging; we can
# re-disable thinking once outputs are stable.
GLM_DEFAULT_DISABLE_THINKING=0

# ---- GLM bring-up toggles (model-specific) ----
GLM4_MOE_LITE_ENABLE_MOE=1
GLM4_MOE_LITE_PREFILL_IMPL=flash_mla_prefill

# KV cache in BF16 for stability.
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf16

# Disable known-risk perf transforms.
GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=0
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1

# Router + experts correctness.
GLM4_MOE_LITE_MOE_ROUTER_IMPL=cpu
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf16

# MoE sparse math: high fidelity, no approx, fp32 accumulation.
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi4
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=1
GLM4_MOE_LITE_MOE_SPARSE_APPROX=0
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
GLM4_MOE_LITE_MOE_FP32_ACC=1

# MLA math: high fidelity, no approx, fp32 accumulation.
GLM4_MOE_LITE_MLA_FIDELITY=hifi4
GLM4_MOE_LITE_MLA_APPROX=0
GLM4_MOE_LITE_MLA_FP32_ACC=1

GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32

