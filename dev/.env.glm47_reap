# Dev Environment Configuration (GLM-4.7-REAP-218B on Galaxy Wormhole)
# CORRECTNESS TEST: rs_ag reduce, no lofi/approx, no fused reduce

MODEL_ENV_FILE=dev/.env.glm47_reap
WORKSPACE_PATH=/home/user/src_docker/ws/glm47_reap_268b_galaxy_wormhole
HF_MODEL=cerebras/GLM-4.7-REAP-218B-A32B
HF_TOKEN=
MESH_DEVICE=TG
BUILD_JOBS=32
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=128
# V1 batch>1 BLOCKED (all_reduce cluster_axis=1 crash). Use bs=1 only.
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

# Trace mode BLOCKED: 92 layers need ~2GB trace buffer but DRAM is full with weights.
# Embedding fix works (pre-allocate+copy), but trace_region needs 2GB vs 10MB allocated.
OVERRIDE_TT_CONFIG={"trace_mode":"none","enable_model_warmup":false,"decode_trace_batch_buckets":[1],"trace_region_size":40000000,"kv_cache_max_tokens_all_users":4096}

# Parallelism
GLM4_MOE_TP=8
GLM4_MOE_EP=32

# BF16 dense, BF8 experts (only combo that fits)
GLM4_MOE_DENSE_TT_DTYPE=bf16
GLM4_MOE_EXPERTS_TT_DTYPE=bf8
GLM4_MOE_KV_CACHE_TT_DTYPE=bf16

# MoE configuration
GLM4_MOE_ENABLE_MOE=1
GLM4_MOE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_MOE_ROUTER_IMPL=tt
GLM4_MOE_MOE_DENSE_PREFILL=1
GLM4_MOE_MOE_SPARSE_PREFILL_PCM=32

# Performance flags (conservative)
GLM4_MOE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_EXPLICIT_PROG_CFG=1
GLM4_MOE_DECODE_L1_ACT=0
GLM4_MOE_EP_L1=0

# NO approximations, NO lofi — max precision for 92 layers
GLM4_MOE_FP32_ACC=0
GLM4_MOE_MOE_SPARSE_FP32_ACC=0

# Use V1 engine
VLLM_USE_V1=1

# Tracy DISABLED
TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0

# Offline mode
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# On-device reduce — rs_ag proven correct (host reduce is BROKEN with DP>1)
GLM4_MOE_REDUCE_IMPL=native
GLM4_MOE_FUSE_SHARED_EP_REDUCE=0
GLM4_MOE_EP_REDUCE_DEVICE=1
GLM4_MOE_DRAM_SHARD=0
NUM_GPU_BLOCKS_OVERRIDE=65

# Lofi fidelity for faster matmuls
#GLM4_MOE_ATTN_FIDELITY=lofi
#GLM4_MOE_MOE_SPARSE_FIDELITY=lofi

# Binary search: partial layer count for trace garbling debug
GLM4_MOE_NUM_LAYERS=92
GLM4_MOE_DEBUG_ALLOW_PARTIAL_LAYERS=1

# Decode-only mode
VLLM_TT_DECODE_ONLY=1
VLLM_TT_WARMUP_OVERRIDE=true

# Unbuffered Python output for log visibility
PYTHONUNBUFFERED=1

# Debug: synchronize before all_reduce to isolate compute vs CCL hang
GLM4_MOE_DEBUG_SYNC=0
