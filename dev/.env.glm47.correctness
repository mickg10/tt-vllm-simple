# Dev Environment Configuration (GLM-4.7-Flash correctness-first on T3K)
#
# Purpose:
# - Disable perf shortcuts until outputs are coherent.
# - Keep KV cache BF8 to avoid known BF16 KV decode warmup L1 CB overflow on this system.
# - Disable model warmup to reduce startup instability while debugging correctness.
#
# Usage:
#   cd /home/ttuser/src_docker/ws/glm47_flash/docker_tt
#   docker compose --env-file dev/.env.glm47.correctness -f dev/docker-compose.yml \
#     up -d --force-recreate vllm-tt
#

# Self-reference so docker-compose.yml can pass this file into the container.
MODEL_ENV_FILE=dev/.env.glm47.correctness

# Path to your workspace (required)
WORKSPACE_PATH=/home/ttuser/src_docker/ws/glm47_flash

# Model configuration
HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

# Device configuration
MESH_DEVICE=T3K

# Build configuration
BUILD_JOBS=16
SKIP_TT_METAL_BUILD=1

# vLLM configuration
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=600

# vLLM TT backend overrides (JSON dict passed to --override-tt-config)
# - tracing disabled (bring-up)
# - warmup disabled (stability while debugging correctness)
OVERRIDE_TT_CONFIG={"trace_mode":"none","enable_model_warmup":false,"fabric_reliability_mode":"RELAXED_INIT"}

# Force-reset devices on startup. GLM bring-up has hit hard crashes that can
# leave ethernet dispatch cores in a bad state; this avoids long hangs.
TT_METAL_RESET_DEVICES=1

# Disable GLM thinking by default for user-facing quality/latency.
GLM_DEFAULT_DISABLE_THINKING=1

# ---- GLM bring-up toggles (model-specific) ----
GLM4_MOE_LITE_ENABLE_MOE=1
# Correctness-first: use iterative decode-per-token prefill to avoid
# FlashMLA prefill path until golden-token alignment is validated.
GLM4_MOE_LITE_PREFILL_IMPL=decode_loop

# KV cache dtype (BF8 required on this system for stability today)
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

# Correctness-first: disable known-risk perf transforms
GLM4_MOE_LITE_TP=0
GLM4_MOE_LITE_FUSE_QKV_A=0
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1
# Decode-mode RoPE has been brittle during bring-up and can cause severe
# quality regressions (gibberish). Keep it off for correctness work.
GLM4_MOE_LITE_USE_DECODE_ROPE=0

# Router + experts correctness
GLM4_MOE_LITE_MOE_ROUTER_IMPL=cpu
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse

# MoE sparse math: high fidelity, no approx, fp32 accumulation
GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=hifi4
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=1
GLM4_MOE_LITE_MOE_SPARSE_APPROX=0
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=1
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0

# Dense/router matmuls: use fp32 accumulation for debugging if needed
GLM4_MOE_LITE_MOE_FP32_ACC=1

# MLA math: high fidelity, no approx
GLM4_MOE_LITE_MLA_FIDELITY=hifi4
GLM4_MOE_LITE_MLA_APPROX=0
GLM4_MOE_LITE_MLA_FP32_ACC=1

# Optional: stage profiling
GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32
