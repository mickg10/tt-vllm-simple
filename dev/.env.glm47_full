# Dev Environment Configuration (GLM-4.7 Full 358B + MTP on Galaxy Wormhole)
# Based on SEED-4 GLM-4.7 config from .env.glm47_reap, adapted for full model + MTP

MODEL_ENV_FILE=dev/.env.glm47_full
WORKSPACE_PATH=/home/user/src_docker/ws/glm47_reap_268b_galaxy_wormhole
HF_MODEL=zai-org/GLM-4.7
HF_TOKEN=
MESH_DEVICE=TG
BUILD_JOBS=32
SKIP_TT_METAL_BUILD=1

# Separate weight cache from REAP (different expert count: 160 vs 96)
GLM4_MOE_CACHE_DIR=/root/.cache/ttnn/models/glm4_moe_glm47_full/vllm

MAX_MODEL_LEN=4096
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

# Trace mode: single bucket [32], decode-only, host sampling (TG mesh constraint)
OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","enable_model_warmup":true,"decode_trace_batch_buckets":[32],"trace_region_size":0,"kv_cache_max_tokens_all_users":4096}

# Parallelism — same as REAP: TP=8, EP=32, DP=4
GLM4_MOE_TP=8
GLM4_MOE_EP=32

# BF4 quantization — SEED-3 config (proven on REAP, applying to GLM-4.7 Full)
# GLM-4.7 Full has 160 experts (vs REAP's 96), 5/device (vs 3)
GLM4_MOE_DENSE_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_TT_DTYPE=bf8
GLM4_MOE_EXPERTS_W1_DTYPE=bf4
GLM4_MOE_EXPERTS_W2_DTYPE=bf4
GLM4_MOE_EXPERTS_W3_DTYPE=bf8
GLM4_MOE_KV_CACHE_TT_DTYPE=bf16

# MoE configuration
GLM4_MOE_ENABLE_MOE=1
GLM4_MOE_MOE_EXPERTS_IMPL=sparse
GLM4_MOE_MOE_ROUTER_IMPL=tt
GLM4_MOE_MOE_DENSE_PREFILL=1
GLM4_MOE_MOE_SPARSE_PREFILL_PCM=32

# MTP (Multi-Token Prediction) — GLM-4.7 Full has num_nextn_predict_layers=1
# Enable once MTP code is ported to glm4_moe
GLM4_MOE_MTP=1

# Performance flags
GLM4_MOE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_EXPLICIT_PROG_CFG=1
GLM4_MOE_DECODE_L1_ACT=0
GLM4_MOE_EP_L1=0
GLM4_MOE_FUSE_EXPERTS_GATE_UP=0
GLM4_MOE_FP32_ACC=0
GLM4_MOE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_QK_L1=1
GLM4_MOE_ROPE_PAD=0

# Use V1 engine
VLLM_USE_V1=1

# Tracy DISABLED
TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0

# Offline mode
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# On-device reduce (same as REAP — proven on TG mesh)
GLM4_MOE_REDUCE_IMPL=native
GLM4_MOE_REDUCE_IMPL_AXIS1=native
GLM4_MOE_FUSE_SHARED_EP_REDUCE=0
GLM4_MOE_EP_REDUCE_DEVICE=1
GLM4_MOE_DRAM_SHARD=0
NUM_GPU_BLOCKS_OVERRIDE=1

# Math fidelity
GLM4_MOE_ATTN_FIDELITY=hifi
GLM4_MOE_MOE_SPARSE_FIDELITY=hifi

# All 92 layers
GLM4_MOE_NUM_LAYERS=92
GLM4_MOE_DEBUG_ALLOW_PARTIAL_LAYERS=1

# Decode-only mode
VLLM_TT_DECODE_ONLY=1
VLLM_TT_WARMUP_OVERRIDE=true

PYTHONUNBUFFERED=1
GLM4_MOE_DEBUG_SYNC=0
