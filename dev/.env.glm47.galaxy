# Dev Environment Configuration (GLM-4.7-Flash on Galaxy Wormhole — perf flags + TP)
#
# Galaxy: 32 Wormhole chips, MESH_DEVICE=TG, 8x9 grid, DP=4 (TP=8 x 4 replicas)
# All proven perf flags from T3K ported. No megafusion (needs Blackhole cores).
#
# Usage:
#   cd /home/user/src_docker/docker_tt  (on Galaxy)
#   sg docker -c 'docker compose --env-file dev/.env.glm47.galaxy \
#     -f dev/docker-compose.yml -f dev/docker-compose.galaxy.yml up -d vllm-tt'

MODEL_ENV_FILE=dev/.env.glm47.galaxy

WORKSPACE_PATH=/home/user/src_docker/ws/glm47_flash_galaxy_wormhole

HF_MODEL=zai-org/GLM-4.7-Flash
HF_TOKEN=

MESH_DEVICE=TG

BUILD_JOBS=32
SKIP_TT_METAL_BUILD=1

MAX_MODEL_LEN=32768
MAX_NUM_SEQS=32
VLLM_RPC_TIMEOUT=600000
VLLM_ENGINE_ITERATION_TIMEOUT_S=14400

OVERRIDE_TT_CONFIG={"trace_mode":"decode_only","trace_region_size":250000000,"enable_model_warmup":true,"sample_on_device_mode":"decode_only","decode_trace_batch_buckets":[1,32]}

GLM_DEFAULT_DISABLE_THINKING=1
TOOL_CALL_PARSER=glm47

GLM4_MOE_LITE_ENABLE_MOE=1
GLM4_MOE_LITE_PREFILL_IMPL=flash_mla_prefill
GLM4_MOE_LITE_KV_CACHE_TT_DTYPE=bf8

# Perf toggles
GLM4_MOE_LITE_TP=1
GLM4_MOE_LITE_DECODE_L1_ACT=1
GLM4_MOE_LITE_DRAM_SHARDED_WEIGHTS=0
GLM4_MOE_LITE_DRAM_SHARDED_ATTN=0
GLM4_MOE_LITE_SHARDED_MLP=0
GLM4_MOE_LITE_EXPLICIT_PROG_CFG=1
GLM4_MOE_LITE_FUSE_QKV_A=1
GLM4_MOE_LITE_MLA_USE_V_CACHE_SLICE=1
GLM4_MOE_LITE_CONCAT_HEADS=1

GLM4_MOE_LITE_MOE_ROUTER_IMPL=tt
GLM4_MOE_LITE_MOE_EXPERTS_IMPL=sparse
# Dense batched matmul for MoE experts during prefill (0=sparse_matmul, 1=dense ttnn.linear)
GLM4_MOE_LITE_MOE_DENSE_PREFILL=1
# Token-packing prefill: gather only routed tokens per expert (overrides dense prefill)
GLM4_MOE_LITE_MOE_PACKED_PREFILL=0

GLM4_MOE_LITE_MOE_SPARSE_FIDELITY=lofi
GLM4_MOE_LITE_MOE_SPARSE_FP32_ACC=0
GLM4_MOE_LITE_MOE_SPARSE_APPROX=1
GLM4_MOE_LITE_MOE_SPARSE_DEBUG=0
GLM4_MOE_LITE_MOE_SPARSE_DISPATCH_IMPL=reduce
GLM4_MOE_LITE_MOE_SPARSE_FORCE_DENSE=0
# Prefill: process up to N sparsity blocks per sparse_matmul call
GLM4_MOE_LITE_MOE_SPARSE_PREFILL_PCM=32

# RFC-1 Phase A: L1 memory for MoE decode experts (0=DRAM default, 1=L1)
GLM4_MOE_LITE_EP_L1=1
# RFC-1 Phase B: Fuse w1+w3 gate_up expert projections (0=separate, 1=fused)
GLM4_MOE_LITE_FUSE_EXPERTS_GATE_UP=1

GLM4_MOE_LITE_ATTN_DP=0
GLM4_MOE_LITE_HEAD_PARALLEL_KVB2=0
GLM4_MOE_LITE_FUSE_MLP_MOE_REDUCE=0
GLM4_MOE_LITE_FUSE_SHARED_GATE_UP=0
GLM4_MOE_LITE_FUSED_SHARED_EXPERT=0
# Fused KV Cache Branch: disabled on Galaxy (megafusion, not ported)
GLM4_MOE_LITE_FUSED_KV_BRANCH=0
# Fused Pre-SDPA: disabled on Galaxy (megafusion, not ported)
GLM4_MOE_LITE_FUSED_PRE_SDPA=0

GLM4_MOE_LITE_MOE_FP32_ACC=0

GLM4_MOE_LITE_MLA_FIDELITY=lofi
GLM4_MOE_LITE_MLA_APPROX=1
GLM4_MOE_LITE_MLA_FP32_ACC=0
GLM4_MOE_LITE_MLA_SHARD_Q=0

# BF8 minimum — BF4 is BANNED (garbled output)
GLM4_MOE_LITE_DENSE_TT_DTYPE=bf8
GLM4_MOE_LITE_EXPERTS_TT_DTYPE=bf8

GLM4_MOE_LITE_SKIP_DEFENSIVE_CLONES=1
GLM4_MOE_LITE_SKIP_TYPECAST=1
GLM4_MOE_LITE_PRESERVE_TRACE=0

GLM4_MOE_LITE_BATCHED_PREFILL=0

# MTP speculative decoding — disabled on Galaxy
GLM4_MOE_LITE_MTP=0
GLM4_MOE_LITE_MTP_TRACED=0
GLM4_MOE_LITE_BATCH_EXPAND=0

# Use V1 engine
VLLM_USE_V1=1

GLM4_MOE_LITE_PROFILE=0
GLM4_MOE_LITE_PROFILE_LAYER=
GLM4_MOE_LITE_PROFILE_PRINT_EVERY=32

# Tracy device profiling (DISABLED)
TT_METAL_DEVICE_PROFILER=0
TT_METAL_PROFILER_CPP_POST_PROCESS=0
TT_METAL_PROFILER_PROGRAM_SUPPORT_COUNT=0
TTNN_OP_PROFILER=0
GLM4_MOE_LITE_TRACY_DUMP_AFTER=0
