# Workspace Manager Configuration
# Copy this file to workspace.env and fill in your values

# Your forks (push to these)
# These should be YOUR personal forks where you have write access
DOCKER_TT_FORK=https://github.com/<your-username>/tt-vllm-simple.git
TT_METAL_FORK=https://github.com/<your-username>/tt-metal.git
#
# NOTE (GitHub fork constraint):
# `tenstorrent/vllm` is a fork of `vllm-project/vllm`. GitHub only allows ONE
# fork per "vllm" network under a given owner. That means:
# - If you already have `https://github.com/<your-username>/vllm.git`, you must
#   reuse it for TT work (push TT branches there).
# - You cannot create a second fork like `<your-username>/vllm-tt` under the
#   same account. If you need a separate TT-named fork, use a different owner
#   namespace (e.g. an organization) or accept a non-fork mirror repo.
VLLM_FORK=https://github.com/<your-username>/vllm.git

# Upstream repositories (fetch from these)
# These are the official Tenstorrent repos (read-only for most users)
TT_METAL_UPSTREAM=https://github.com/tenstorrent/tt-metal.git
VLLM_UPSTREAM=https://github.com/tenstorrent/vllm.git

# Base directory for workspaces (default: parent of docker_tt)
# WORKSPACE_BASE=/home/ttuser/src_docker

# Default branches for upstream tracking
TT_METAL_DEFAULT_BRANCH=main
VLLM_DEFAULT_BRANCH=dev
